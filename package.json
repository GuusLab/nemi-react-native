{
  "name": "@guuslab/nemi-react-native",
  "version": "0.1.0",
  "description": "Sign in with Nemi for React Native and Expo: PKCE, secure token storage and an auto-refreshing API client.",
  "license": "MIT",
  "author": "GuusLab (https://nemilab.com)",
  "homepage": "https://dev.nemilab.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuusLab/nemi-react-native.git"
  },
  "bugs": {
    "url": "https://github.com/GuusLab/nemi-react-native/issues"
  },
  "keywords": [
    "nemi",
    "oauth",
    "oidc",
    "pkce",
    "react-native",
    "expo",
    "sign-in"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@guuslab/nemi": "^0.1.0"
  },
  "peerDependencies": {
    "expo-crypto": ">=12.0.0",
    "expo-secure-store": ">=12.0.0",
    "expo-web-browser": ">=12.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "peerDependenciesMeta": {
    "expo-crypto": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "expo-web-browser": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "expo-crypto": "^57.0.4",
    "expo-modules-core": "^57.0.22",
    "expo-secure-store": "^57.0.4",
    "expo-web-browser": "^57.0.3",
    "react": "^19.3.0",
    "react-native": "^0.87.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
